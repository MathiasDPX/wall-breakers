DEBUG=false

# Monitoring
SENTRY_DSN=https://pubkey@host/project_id
SENTRY_ENVIRONMENT=development
# Needed only when serving with several gunicorn workers
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# Workers
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=60

# Sources

# Ouest France
OUESTFRANCE_AZP=bms-sso-login
OUESTFRANCE_REFRESH_TOKEN=ey...

# Mediapart
ENABLE_MP=false

# Socialter
ENABLE_SA=false